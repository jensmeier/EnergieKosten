{
    "elements": [
        {
            "type": "Label",
            "caption": "Energie & Kosten – V1 BUILD9. Rasteradaptive Kachel: eigenes Layout für 1x1, 1x2/1x3, 2x1, 2x2, 3x1, 3x2, 2x3 und 3x3. Kleine Raster zeigen bewusst weniger statt alles winzig zu skalieren."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Quellen",
            "expanded": true,
            "items": [
                {
                    "type": "SelectVariable",
                    "name": "GridImportVariable",
                    "caption": "Netzbezug Gesamtzähler (Fronius)",
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "SelectVariable",
                    "name": "FeedInVariable",
                    "caption": "Einspeisung Gesamtzähler (Fronius)",
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "SelectVariable",
                    "name": "HeaterPowerVariable",
                    "caption": "Heizstab Leistung in W",
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "AutoArchive",
                    "caption": "Benötigte Archivierung automatisch einschalten"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Kosten / Heizöl",
            "expanded": true,
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "GridPrice",
                    "caption": "Strompreis Netzbezug",
                    "digits": 4,
                    "minimum": 0,
                    "maximum": 5,
                    "suffix": " €/kWh"
                },
                {
                    "type": "NumberSpinner",
                    "name": "FeedInPrice",
                    "caption": "Einspeisevergütung",
                    "digits": 4,
                    "minimum": 0,
                    "maximum": 5,
                    "suffix": " €/kWh"
                },
                {
                    "type": "NumberSpinner",
                    "name": "OilEnergyKWhPerLiter",
                    "caption": "Heizöl Energiegehalt",
                    "digits": 2,
                    "minimum": 1,
                    "maximum": 20,
                    "suffix": " kWh/L"
                },
                {
                    "type": "NumberSpinner",
                    "name": "BoilerEfficiencyPercent",
                    "caption": "Kesselwirkungsgrad",
                    "digits": 1,
                    "minimum": 10,
                    "maximum": 100,
                    "suffix": " %"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Kachel",
            "expanded": true,
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "CycleSeconds",
                    "caption": "Automatischer Wechsel Heute → Monat → Jahr",
                    "minimum": 3,
                    "maximum": 60,
                    "suffix": " s"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "BUILD9: Raster-Engine erkennt die verfügbare Kachelgeometrie aus Breite/Höhe und wählt dafür ein eigenes Layout. 1x1 zeigt nacheinander Netzbezug, Einspeisung und Heizstab; 2x1/3x1 nutzen drei Spalten; 2x2/2x3/3x3 zeigen die vollständige Übersicht. Symcon-Farben, Detailansicht, Archivdaten, Historie und Berechnungslogik aus BUILD8 bleiben erhalten."
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Kachel jetzt aktualisieren",
            "onClick": "EK_Refresh($id);"
        }
    ]
}
