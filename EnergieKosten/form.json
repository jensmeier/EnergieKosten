{
    "elements": [
        {
            "type": "Label",
            "caption": "Energie & Kosten – V1 BUILD6. Detaildiagramm auf dem Tablet horizontal durch die geloggte Historie scrollen. Jahresrechnung zeigt Einspeisung und Netzbezug jeweils bisher + Hochrechnung sowie die Energiebilanz in Euro."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Quellen",
            "expanded": true,
            "items": [
                {
                    "type": "SelectVariable",
                    "name": "GridImportVariable",
                    "caption": "Netzbezug Gesamtzähler (Fronius)",
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "SelectVariable",
                    "name": "FeedInVariable",
                    "caption": "Einspeisung Gesamtzähler (Fronius)",
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "SelectVariable",
                    "name": "HeaterPowerVariable",
                    "caption": "Heizstab Leistung in W",
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "AutoArchive",
                    "caption": "Benötigte Archivierung automatisch einschalten"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Kosten / Heizöl",
            "expanded": true,
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "GridPrice",
                    "caption": "Strompreis Netzbezug",
                    "digits": 4,
                    "minimum": 0,
                    "maximum": 5,
                    "suffix": " €/kWh"
                },
                {
                    "type": "NumberSpinner",
                    "name": "FeedInPrice",
                    "caption": "Einspeisevergütung",
                    "digits": 4,
                    "minimum": 0,
                    "maximum": 5,
                    "suffix": " €/kWh"
                },
                {
                    "type": "NumberSpinner",
                    "name": "OilEnergyKWhPerLiter",
                    "caption": "Heizöl Energiegehalt",
                    "digits": 2,
                    "minimum": 1,
                    "maximum": 20,
                    "suffix": " kWh/L"
                },
                {
                    "type": "NumberSpinner",
                    "name": "BoilerEfficiencyPercent",
                    "caption": "Kesselwirkungsgrad",
                    "digits": 1,
                    "minimum": 10,
                    "maximum": 100,
                    "suffix": " %"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Kachel",
            "expanded": true,
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "CycleSeconds",
                    "caption": "Automatischer Wechsel Heute → Monat → Jahr",
                    "minimum": 3,
                    "maximum": 60,
                    "suffix": " s"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "BUILD6: Tag bis 7 Tage zurück; Woche und 30-Tage-Ansicht bis ca. 400 Tage zurück horizontal scrollen. Antippen eines Balkens zeigt kWh, Euro und Energiebilanz. Jahresrechnung ohne Heizstab/Deckungsprozente: bisherige Werte + Hochrechnung + Energiebilanz. Vorhandene IDs/Skripte bleiben unverändert."
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Kachel jetzt aktualisieren",
            "onClick": "EK_Refresh($id);"
        }
    ]
}
