{
    "elements": [
        {
            "type": "Label",
            "caption": "Energie & Kosten – V1 BUILD3. Vorhandene Tag/Woche/Monat/Jahr-Werte und geloggte Tagesdaten werden automatisch weiterverwendet. Bestehende Skripte bleiben unverändert."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Quellen",
            "expanded": true,
            "items": [
                {
                    "type": "SelectVariable",
                    "name": "GridImportVariable",
                    "caption": "Netzbezug Gesamtzähler (Fronius)",
                    "validVariableTypes": [1, 2]
                },
                {
                    "type": "SelectVariable",
                    "name": "FeedInVariable",
                    "caption": "Einspeisung Gesamtzähler (Fronius)",
                    "validVariableTypes": [1, 2]
                },
                {
                    "type": "SelectVariable",
                    "name": "HeaterPowerVariable",
                    "caption": "Heizstab Leistung in W",
                    "validVariableTypes": [1, 2]
                },
                {
                    "type": "CheckBox",
                    "name": "AutoArchive",
                    "caption": "Benötigte Archivierung automatisch einschalten"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Kosten / Heizöl",
            "expanded": true,
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "GridPrice",
                    "caption": "Strompreis Netzbezug",
                    "digits": 4,
                    "minimum": 0,
                    "maximum": 5,
                    "suffix": " €/kWh"
                },
                {
                    "type": "NumberSpinner",
                    "name": "FeedInPrice",
                    "caption": "Einspeisevergütung",
                    "digits": 4,
                    "minimum": 0,
                    "maximum": 5,
                    "suffix": " €/kWh"
                },
                {
                    "type": "NumberSpinner",
                    "name": "OilEnergyKWhPerLiter",
                    "caption": "Heizöl Energiegehalt",
                    "digits": 2,
                    "minimum": 1,
                    "maximum": 20,
                    "suffix": " kWh/L"
                },
                {
                    "type": "NumberSpinner",
                    "name": "BoilerEfficiencyPercent",
                    "caption": "Kesselwirkungsgrad",
                    "digits": 1,
                    "minimum": 10,
                    "maximum": 100,
                    "suffix": " %"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Kachel",
            "expanded": true,
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "CycleSeconds",
                    "caption": "Automatischer Wechsel Heute → Monat → Jahr",
                    "minimum": 3,
                    "maximum": 60,
                    "suffix": " s"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "BUILD3 verwendet für die Kachel automatisch die bereits vorhandenen kWh-/€-Summen. Für Diagramm und saisonale Prognose werden bevorzugt die geloggten Tageszähler ausgewertet. Es werden dafür keine zusätzlichen Tag/Woche/Monat/Jahr-Variablen angelegt."
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Kachel jetzt aktualisieren",
            "onClick": "EK_Refresh($id);"
        }
    ]
}
